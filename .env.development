# 变量必须以 VITE_ 为前缀才能暴露给外部读取  通过import.meta.env获取环境变量
# 开发环境
NODE_ENV = 'development'

# 开发环境，默认BASEURL
VITE_BASE_URL = '/focusHz'

# 开发环境，公共资源地址
VITE_BASE_PUBLICPATH = './'
# 开发环境，路由前缀
VITE_BASE_BASE = '/'

# 开发环境，Url地址
VITE_BASE_COMSWAT = 'http://127.0.0.1:8000'

# MQTT地址
VITE_BASE_MQTT = 'ws://61.191.199.84:8088/mqtt'

VITE_TITLE_NAME = '多平台展示大屏'

VITE_BASE_OUT_DIR = 'dist'