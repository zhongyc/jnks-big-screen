# 变量必须以 VITE_ 为前缀才能暴露给外部读取  通过import.meta.env获取环境变量
# 开发环境
NODE_ENV = 'test'

# 开发环境，默认BASEURL
VITE_BASE_URL = '/focusHz'

# 开发环境，公共资源地址
VITE_BASE_PUBLICPATH = '/aotiCompany'
# 开发环境，路由前缀
VITE_BASE_BASE = '/aotiCompany'

# 开发环境，Url地址
VITE_BASE_COMSWAT = 'https://www.zjjnks.cn/gateway'

# MQTT地址
VITE_BASE_MQTT = 'wss://www.zjjnks.cn/swat/mqtt'

VITE_TITLE_NAME = '多平台展示大屏'
